# de-platform environment template
#
# Copy this file to .env and fill in real values:  cp .env.example .env
# Never commit a real value. This file is the committed template only; .env is
# gitignored.
#
# Real values live only under runtime/ (gitignored) and are mounted read-only
# at /run/secrets/<name>. Variables ending in _FILE hold those mount paths, so a
# container receives the secret as a file, not as an environment value.
#
# Naming: POSTGRES_PASSWORD_FILE and GF_SECURITY_ADMIN_PASSWORD__FILE are the
# components' own native file-intake variables. Every other *_FILE variable is
# this project's convention for pointing a compose service at a path under
# /run/secrets.
#
# Every placeholder below is deliberately not a valid credential.

# ---------------------------------------------------------------------------
# PostgreSQL 18.x (metadata stores: Polaris, Dagster, Apicurio, Marquez)
# ---------------------------------------------------------------------------
POSTGRES_USER=deplatform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deplatform
# The _FILE form overrides POSTGRES_PASSWORD in the official image.
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# ---------------------------------------------------------------------------
# Kafka 4.3.1 (KRaft, SASL_SSL, SCRAM-SHA-256)
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SECURITY_PROTOCOL=SASL_SSL
# One SCRAM principal per client; each password comes from a mounted file.
KAFKA_DEBEZIUM_USERNAME=debezium
KAFKA_DEBEZIUM_PASSWORD_FILE=/run/secrets/kafka_debezium_password
KAFKA_FLINK_USERNAME=flink
KAFKA_FLINK_PASSWORD_FILE=/run/secrets/kafka_flink_password
KAFKA_CONNECT_USERNAME=kafka-connect
KAFKA_CONNECT_PASSWORD_FILE=/run/secrets/kafka_connect_password
# TLS is PEM mode: ssl.keystore.type=PEM with an unencrypted PKCS#8 key. There
# is deliberately NO keystore-password variable, because Kafka documents that
# keystore and truststore passwords are not supported for PEM format. The
# private key file is the secret.
KAFKA_SSL_KEY_FILE=/run/secrets/kafka_ssl_key
KAFKA_SSL_CERT_FILE=/run/secrets/kafka_ssl_cert
KAFKA_SSL_CA_FILE=/run/secrets/kafka_ssl_ca

# ---------------------------------------------------------------------------
# Debezium 3.6.1 source connector (PostgreSQL logical replication)
# ---------------------------------------------------------------------------
DEBEZIUM_POSTGRES_USER=debezium_source
DEBEZIUM_POSTGRES_PASSWORD_FILE=/run/secrets/debezium_postgres_password

# ---------------------------------------------------------------------------
# Polaris 1.7.0 (bootstrap credentials plus one OAuth2 client per service)
# ---------------------------------------------------------------------------
# Format is realm,principal,secret. Consumed only at first bootstrap.
POLARIS_BOOTSTRAP_CREDENTIALS=POLARIS,root,change-me
POLARIS_TOKEN_TTL=3600
POLARIS_CLIENT_ID_SPARK=spark
POLARIS_CLIENT_SECRET_FILE_SPARK=/run/secrets/polaris_spark_secret
POLARIS_CLIENT_ID_FLINK=flink
POLARIS_CLIENT_SECRET_FILE_FLINK=/run/secrets/polaris_flink_secret
POLARIS_CLIENT_ID_CLICKHOUSE=clickhouse
POLARIS_CLIENT_SECRET_FILE_CLICKHOUSE=/run/secrets/polaris_clickhouse_secret

# ---------------------------------------------------------------------------
# SeaweedFS 4.47 (S3 gateway, local object store)
# ---------------------------------------------------------------------------
SEAWEEDFS_S3_ACCESS_KEY=seaweedfs
SEAWEEDFS_S3_SECRET_KEY_FILE=/run/secrets/seaweedfs_s3_secret

# ---------------------------------------------------------------------------
# ClickHouse 26.8 LTS (one password per principal)
# ---------------------------------------------------------------------------
CLICKHOUSE_ENGINEER_PASSWORD_FILE=/run/secrets/clickhouse_engineer_password
CLICKHOUSE_SVC_PLATFORM_PASSWORD_FILE=/run/secrets/clickhouse_svc_platform_password
CLICKHOUSE_ANALYST_COMMERCIAL_PASSWORD_FILE=/run/secrets/clickhouse_analyst_commercial_password
CLICKHOUSE_ANALYST_NETWORK_PASSWORD_FILE=/run/secrets/clickhouse_analyst_network_password
CLICKHOUSE_ANALYST_OPS_PASSWORD_FILE=/run/secrets/clickhouse_analyst_ops_password
CLICKHOUSE_DQ_READER_PASSWORD_FILE=/run/secrets/clickhouse_dq_reader_password

# ---------------------------------------------------------------------------
# Grafana 13.x
# ---------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
# Grafana's own file-intake variable, with the double underscore it requires.
GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_password

# ---------------------------------------------------------------------------
# Alertmanager 0.34.x
# ---------------------------------------------------------------------------
ALERTMANAGER_SMTP_PASSWORD_FILE=/run/secrets/alertmanager_smtp_password
ALERTMANAGER_WEBHOOK_URL_FILE=/run/secrets/alertmanager_webhook_url

# ---------------------------------------------------------------------------
# AWS cloud only (authored, never applied)
# ---------------------------------------------------------------------------
AWS_REGION=ap-southeast-5
AWS_SECRETS_MANAGER_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-5:000000000000:secret:de-platform/placeholder
# There are no static AWS credentials in this file. In the cluster, IRSA issues
# short-lived credentials per pod, and the node instance role carries no S3 or
# Secrets Manager permissions.

# ---------------------------------------------------------------------------
# Local CA (development TLS)
# ---------------------------------------------------------------------------
DEV_CA_DIR=./runtime/ca
