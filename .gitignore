# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env and secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.p12
secrets/
runtime/

# Backup files can carry secrets minted at bootstrap (see ADR-0006)
*.bak

# Build and run output
target/
build/
dist/
*.log
jars/

# OpenTofu: the provider and module cache is not tracked, the lock file is
# (docs/cloud-architecture.md section 7).
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
override.tf
override.tf.json

# Gradle: the wrapper's build cache is not tracked.
.gradle/
