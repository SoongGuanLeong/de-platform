<?xml version="1.0"?>
<!--
  Client trust configuration for the security evidence harness.

  The server's certificate is signed by the harness's local CA, which the system
  trust store does not know. Without this the client refuses the connection with
  "certificate verify failed", which is itself evidence that verification is on:
  a client that does not trust the chain is refused rather than downgraded.
-->
<clickhouse>
  <openSSL>
    <client>
      <caConfig>/certs/ca.crt</caConfig>
      <verificationMode>strict</verificationMode>
      <loadDefaultCAFile>false</loadDefaultCAFile>
      <cacheSessions>true</cacheSessions>
    </client>
  </openSSL>
</clickhouse>
