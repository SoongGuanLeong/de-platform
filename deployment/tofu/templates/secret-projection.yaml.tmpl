# The cloud secrets form: AWS Secrets Manager values projected by the Secrets
# Store CSI driver into a tmpfs mount, read-only, at /run/secrets/<name>
# (docs/security-model.md section 2.6, ADR-0028). The Helm chart that mounts it
# is issue #75; this template is the module's declared projection so the
# filePermission override is reviewable here.
apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: ${name_prefix}-secrets
  namespace: ${namespace}
spec:
  provider: aws
  parameters:
    region: ${region}
    objects: |
${objects}
---
# The pod volume that projects the values. The driver's default filePermission is
# 0644 and its AWS provider's is also 0644, so 0400 is set explicitly.
apiVersion: v1
kind: Pod
metadata:
  name: ${name_prefix}-secret-projection-example
  namespace: ${namespace}
spec:
  serviceAccountName: polaris
  containers:
    - name: example
      image: scratch
      volumeMounts:
        - name: secrets
          mountPath: /run/secrets
          readOnly: true
  volumes:
    - name: secrets
      csi:
        driver: secrets-store.csi.k8s.io
        readOnly: true
        volumeAttributes:
          secretProviderClass: ${name_prefix}-secrets
          filePermission: "0400"
